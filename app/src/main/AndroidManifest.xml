<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Live IPTV streams require network access. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Google Cast device discovery. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Keep the screen on while a stream is actively playing. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Declares Picture-in-Picture support (checked at runtime; app works fine without it). -->
    <uses-feature
        android:name="android.software.picture_in_picture"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".LezzwatchApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lezzwatch"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <!-- usesCleartextTraffic is enabled because some public IPTV streams are served over
             plain HTTP. Tighten this with a network security config if you curate an all-HTTPS
             playlist. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Lezzwatch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Dedicated player activity so Picture-in-Picture and full-screen playback have a
             clean, isolated lifecycle that doesn't fight with the bottom-nav host activity. -->
        <!-- screenOrientation is intentionally left unspecified (follows the device's own
             rotation/orientation lock) rather than forced to landscape: most phone users watch
             one-handed in portrait, with the video simply letterboxed, and can rotate to
             landscape for a true full-bleed picture. -->
        <activity
            android:name=".player.PlayerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="false"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.Lezzwatch.Player" />

        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.lezzwatch.app.player.cast.LezzwatchCastOptionsProvider" />

    </application>

</manifest>
